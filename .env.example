# ============================================================
# tuentidad — Variables de entorno
# ============================================================
# Copia este archivo como .env (nunca subas .env al repositorio).
# Ajusta los valores según el entorno donde ejecutes la app.
# ============================================================

# ------------------------------------------------------------------
# ENTORNO
# Valores posibles: development | staging | production
# ------------------------------------------------------------------
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8080

# ------------------------------------------------------------------
# BASE DE DATOS
# En desarrollo usa una BD local (ver devcontainer).
# En staging/producción, usa las credenciales del servidor real.
# NUNCA uses las credenciales de producción en desarrollo.
# ------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tuentidad_dev
DB_USERNAME=tuentidad_user
DB_PASSWORD=CAMBIA_ESTA_CONTRASEÑA

# ------------------------------------------------------------------
# SESIONES / SEGURIDAD
# Genera un valor aleatorio largo para cada entorno:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ------------------------------------------------------------------
APP_SECRET=CAMBIA_ESTE_SECRETO_POR_UNO_ALEATORIO

# ------------------------------------------------------------------
# ALMACENAMIENTO / UPLOADS
# ------------------------------------------------------------------
STORAGE_DRIVER=local
STORAGE_PATH=./storage/uploads

# ------------------------------------------------------------------
# CORREO (opcional en desarrollo — puedes usar Mailtrap o similar)
# ------------------------------------------------------------------
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=USUARIO_MAILTRAP
MAIL_PASSWORD=CONTRASEÑA_MAILTRAP
MAIL_FROM_ADDRESS=noreply@tuentidad.es
MAIL_FROM_NAME=tuentidad

# ==================================================================
# VARIABLES NECESARIAS EN GITHUB CODESPACES
# ==================================================================
# Configúralas en: Settings del repositorio → Codespaces → Secrets
#
#   DB_PASSWORD       → contraseña de la BD local de desarrollo
#   APP_SECRET        → secreto de sesión para desarrollo
#
# ==================================================================

# ==================================================================
# VARIABLES NECESARIAS EN GITHUB ACTIONS SECRETS
# ==================================================================
# Configúralas en: Settings del repositorio → Secrets and variables → Actions
#
# Para despliegue en producción (rama main):
#   PROD_DB_HOST      → host del servidor de BD en producción
#   PROD_DB_DATABASE  → nombre de la BD en producción
#   PROD_DB_USERNAME  → usuario de la BD en producción
#   PROD_DB_PASSWORD  → contraseña de la BD en producción
#   PROD_SSH_HOST     → IP o hostname del servidor de producción
#   PROD_SSH_USER     → usuario SSH del servidor de producción
#   PROD_SSH_PRIVATE_KEY → clave privada SSH (sin passphrase, solo para CI)
#   PROD_APP_PATH     → ruta absoluta de la app en el servidor
#
# Para entorno de staging (si existe):
#   STAGING_DB_HOST
#   STAGING_DB_DATABASE
#   STAGING_DB_USERNAME
#   STAGING_DB_PASSWORD
#
# ==================================================================
