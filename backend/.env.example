# Variables de producción de tuentidad.
# No edites este archivo a mano en el servidor: ejecuta ./configurar-env.sh,
# que pregunta cada valor, valida el formato y lo guarda en .env.

CI_ENVIRONMENT = 'production'
app.baseURL = 'https://tuentidad.es/'

# Panel OVH › Web Cloud › Bases de datos
database.default.hostname = ''
database.default.database = ''
database.default.username = ''
database.default.password = ''
database.default.port = '3306'
database.default.DBDriver = 'MySQLi'
database.default.charset = 'utf8mb4'
database.default.DBCollat = 'utf8mb4_unicode_ci'

# Cuenta de correo de OVH usada para enviar invitaciones
email.protocol = 'smtp'
email.fromEmail = 'no-reply@tuentidad.es'
email.fromName = 'tuentidad'
email.SMTPHost = 'ssl0.ovh.net'
email.SMTPUser = ''
email.SMTPPass = ''
email.SMTPPort = '465'
email.SMTPCrypto = 'ssl'

# Se genera automáticamente la primera vez. No la cambies después:
# los datos cifrados con la clave anterior dejarían de poder leerse.
encryption.key = ''

# Token de los endpoints de despliegue (/api/deploy/*). Vacío = desactivados.
tuentidad.deployToken = ''
